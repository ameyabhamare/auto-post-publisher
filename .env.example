# Claude API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Signs login cookies. Use a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, one is generated and stored in users/.secret_key.
SECRET_KEY=
# Set to true when the app is served over HTTPS.
# SECURE_COOKIES=true

# Default posts repo for users who don't set their own on the Account page.
# Fine-grained GitHub token, scoped to the posts repo only.
# Permissions: Contents (read & write), Pull requests (read & write).
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-posts-repo
GITHUB_BASE_BRANCH=main
POSTS_DIR_IN_REPO=posts

# Optional: author name for users who haven't set a display or author name
AUTHOR_NAME=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Style learning
# EXAMPLE_COUNT=3           example posts sent with each draft (examples/ first, then published posts)
# STYLE_SOURCE_COUNT=10     published posts read when generating a style file
