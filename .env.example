# Claude API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Fine-grained GitHub token, scoped to the posts repo only.
# Permissions: Contents (read & write), Pull requests (read & write).
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-posts-repo
GITHUB_BASE_BRANCH=main
POSTS_DIR_IN_REPO=posts

# Optional
AUTHOR_NAME=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
